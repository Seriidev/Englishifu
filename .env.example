# Copy to Vercel Project → Settings → Environment Variables (never commit real keys).

# AI scoring
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Postgres — local Docker default (npm run db:up). Swap for Vercel/Supabase later.
POSTGRES_URL=postgres://englishcore:englishcore@127.0.0.1:5432/englishcore

# Auth session JWT (httpOnly cookie + Bearer). Generate: openssl rand -hex 32
# JWT_SECRET is an optional alias — SESSION_SECRET is the primary name.
SESSION_SECRET=
# JWT_SECRET=

# Admin moderation panel (/admin)
ADMIN_PASSWORD=

# Optional email sending for admin messages (https://resend.com)
# RESEND_API_KEY=
# RESEND_FROM=Englishcore <hello@yourdomain.com>
# APP_BASE_URL=https://englishcore.vercel.app

# Optional aliases (also accepted by the API helpers)
# DATABASE_URL=
# BOOKING_AUTH_SECRET=
# ADMIN_SECRET=
